{
  "architecture": "efficientnet_b0",
  "image_size": 224,
  "batch_size": 32,
  "epochs": 12,
  "learning_rate": 0.0003,
  "head_epochs": 4,
  "finetune_epochs": 8,
  "head_learning_rate": 0.001,
  "finetune_learning_rate": 0.00008,
  "unfreeze_last_blocks": 3,
  "early_stopping_patience": 4,
  "weighted_loss": true,
  "random_seed": 42,
  "augmentation": {
    "random_resized_crop_scale": [0.8, 1.0],
    "horizontal_flip_probability": 0.5,
    "rotation_degrees": 8,
    "brightness": 0.15,
    "contrast": 0.15,
    "saturation": 0.1
  }
}
