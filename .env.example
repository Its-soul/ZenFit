APP_NAME=ZenFit
APP_ENV=development
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000

POSTGRES_DB=fitness_os
POSTGRES_USER=fitness_user
POSTGRES_PASSWORD=<replace-with-local-postgres-password>
DATABASE_URL=postgresql+psycopg://fitness_user:<replace-with-url-encoded-local-postgres-password>@postgres:5432/fitness_os

REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

JWT_SECRET_KEY=<replace-with-random-64-character-secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_RETURN_TOKEN=false

LOCAL_UPLOAD_DIR=uploads
USDA_API_KEY=<replace-with-usda-fooddata-central-api-key>
GEMINI_API_KEY=<replace-with-google-gemini-api-key>
# Optional aliases accepted by backend settings:
# GOOGLE_API_KEY=<replace-with-google-gemini-api-key>
# GOOGLE_CLOUD_VISION_API_KEY=<replace-with-google-gemini-api-key>
GEMINI_VISION_MODEL=gemini-3.5-flash

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
