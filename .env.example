APP_NAME=ZenFit
APP_ENV=development
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000
BACKEND_CORS_ORIGIN_REGEX=

POSTGRES_DB=fitness_os
POSTGRES_USER=fitness_user
POSTGRES_PASSWORD=<replace-with-local-postgres-password>
DATABASE_URL=postgresql+psycopg://fitness_user:<replace-with-url-encoded-local-postgres-password>@postgres:5432/fitness_os
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

JWT_SECRET_KEY=<replace-with-random-64-character-secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_RETURN_TOKEN=false

LOCAL_UPLOAD_DIR=uploads
USDA_FDC_API_KEY=
KAGGLE_API_TOKEN=
AI_HEAVY_MODELS_ENABLED=false
AI_PREWARM_MODELS=false
AI_MEAL_CLASSIFIER_ENABLED=false
AI_MEAL_CLASSIFIER_VERSION=
AI_MEAL_CLASSIFIER_ENVIRONMENT=developer-beta
AI_MEAL_CLASSIFIER_ARTIFACT_PREFIX=meal-classifier
AI_ARTIFACT_STORAGE_BACKEND=local
AI_ARTIFACT_LOCAL_DIR=./data/artifacts
AI_ARTIFACT_S3_BUCKET=
AI_ARTIFACT_S3_ENDPOINT=
MEAL_CLASSIFIER_HIGH_CONFIDENCE=0.80
MEAL_CLASSIFIER_MIN_CONFIDENCE=0.55
FOODSAM_MODEL_DIR=./data/models/foodsam
FOODSEG103_MODEL_DIR=./data/models/foodseg103

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
